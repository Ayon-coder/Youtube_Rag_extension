{
  "manifest_version": 3,
  "name": "Ask This Video",
  "version": "0.1.0",
  "description": "Ask questions about any YouTube video using its captions.",
  "action": {
    "default_popup": "popup.html",
    "default_title": "Ask This Video"
  },
  "permissions": ["tabs", "storage"],
  "host_permissions": ["http://localhost:8000/*"]
}
